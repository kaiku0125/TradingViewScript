refreshPivotLabels() =>
    clearPivotLabels(highTriangleLabels)
    clearPivotLabels(lowTriangleLabels)
    clearPivotLabels(highStructureLabels)
    clearPivotLabels(lowStructureLabels)

    if showLabels
        if showAllHL
            if array.size(pivotState.allHighs) > 0
                for i = 0 to array.size(pivotState.allHighs) - 1
                    int highBar = array.get(pivotState.allHighBars, i)
                    float highPrice = array.get(pivotState.allHighs, i)
                    int highBarsAgo = bar_index - highBar
                    array.push(highTriangleLabels, createHighLabel(highBar, highPrice, highBarsAgo))
                    trimPivotLabels(highTriangleLabels)
                    if showStructureLabels
                        label highStructureLabel = createStructureLabel(true, highBar, highPrice, highBarsAgo, array.get(pivotState.allHighStructures, i), array.get(pivotState.allHighBarCounts, i))
                        if not na(highStructureLabel)
                            array.push(highStructureLabels, highStructureLabel)
                            trimPivotLabels(highStructureLabels)
            if array.size(pivotState.allLows) > 0
                for i = 0 to array.size(pivotState.allLows) - 1
                    int lowBar = array.get(pivotState.allLowBars, i)
                    float lowPrice = array.get(pivotState.allLows, i)
                    int lowBarsAgo = bar_index - lowBar
                    array.push(lowTriangleLabels, createLowLabel(lowBar, lowPrice, lowBarsAgo))
                    trimPivotLabels(lowTriangleLabels)
                    if showStructureLabels
                        label lowStructureLabel = createStructureLabel(false, lowBar, lowPrice, lowBarsAgo, array.get(pivotState.allLowStructures, i), array.get(pivotState.allLowBarCounts, i))
                        if not na(lowStructureLabel)
                            array.push(lowStructureLabels, lowStructureLabel)
                            trimPivotLabels(lowStructureLabels)
        else
            string structureDirection = getCurrentStructureDirection()
            int displayHighIndex = array.size(pivotState.allHighs) > 0 ? array.size(pivotState.allHighs) - 1 : na
            int displayLowIndex = array.size(pivotState.allLows) > 0 ? array.size(pivotState.allLows) - 1 : na

            if structureDirection == "多頭延續" and not na(displayHighIndex)
                int referenceHighBar = array.get(pivotState.allHighBars, displayHighIndex)
                for lowIndex = array.size(pivotState.allLows) - 1 to 0
                    if array.get(pivotState.allLowBars, lowIndex) < referenceHighBar
                        displayLowIndex := lowIndex
                        break
            else if structureDirection == "空頭延續" and not na(displayLowIndex)
                int referenceLowBar = array.get(pivotState.allLowBars, displayLowIndex)
                for highIndex = array.size(pivotState.allHighs) - 1 to 0
                    if array.get(pivotState.allHighBars, highIndex) < referenceLowBar
                        displayHighIndex := highIndex
                        break

            if not na(displayHighIndex)
                int lastHighBarValue = array.get(pivotState.allHighBars, displayHighIndex)
                float lastHighPriceValue = array.get(pivotState.allHighs, displayHighIndex)
                int lastHighBarsAgo = bar_index - lastHighBarValue
                array.push(highTriangleLabels, createHighLabel(lastHighBarValue, lastHighPriceValue, lastHighBarsAgo))
                if showStructureLabels
                    label lastHighStructureLabel = createStructureLabel(true, lastHighBarValue, lastHighPriceValue, lastHighBarsAgo, array.get(pivotState.allHighStructures, displayHighIndex), array.get(pivotState.allHighBarCounts, displayHighIndex))
                    if not na(lastHighStructureLabel)
                        array.push(highStructureLabels, lastHighStructureLabel)
            if not na(displayLowIndex)
                int lastLowBarValue = array.get(pivotState.allLowBars, displayLowIndex)
                float lastLowPriceValue = array.get(pivotState.allLows, displayLowIndex)
                int lastLowBarsAgo = bar_index - lastLowBarValue
                array.push(lowTriangleLabels, createLowLabel(lastLowBarValue, lastLowPriceValue, lastLowBarsAgo))
                if showStructureLabels
                    label lastLowStructureLabel = createStructureLabel(false, lastLowBarValue, lastLowPriceValue, lastLowBarsAgo, array.get(pivotState.allLowStructures, displayLowIndex), array.get(pivotState.allLowBarCounts, displayLowIndex))
                    if not na(lastLowStructureLabel)
                        array.push(lowStructureLabels, lastLowStructureLabel)

if barstate.isconfirmed
    float minDeviation = deviationInput * syminfo.mintick

    if showAllHL != previousShowAllHL or showLabels != previousShowLabels or hlLabelDisplayMode != previousHlLabelDisplayMode or showStructureLabels != previousShowStructureLabels or showStructureBarCount != previousShowStructureBarCount
        refreshPivotLabels()
        previousShowAllHL := showAllHL
        previousShowLabels := showLabels
        previousHlLabelDisplayMode := hlLabelDisplayMode
        previousShowStructureLabels := showStructureLabels
        previousShowStructureBarCount := showStructureBarCount

    bool pivotChanged = zigzag.processConfirmedBar(pivotState, zigHighPoint, zigLowPoint, confirmedHighBar, confirmedLowBar, minDeviation, MAX_PIVOTS)

    [nextTdBull, nextTdBear] = tdseq.next(tdBullishSetupCount, tdBearishSetupCount, close, close[4])
    tdBullishSetupCount := nextTdBull
    tdBearishSetupCount := nextTdBear

    if pivotChanged
        int nextStructureState = getStructureStateFromStructures()

        if nextStructureState == STRUCTURE_BULL or nextStructureState == STRUCTURE_BEAR
            currentStructureState := nextStructureState
            previousConfirmedTrendState := nextStructureState
            mixedAnchorTrendState := STRUCTURE_UNKNOWN
            isFirstMixedTransition := false
            mixedFibPairValid := false
            mixedFibLow := na
            mixedFibLowBar := na
            mixedFibHigh := na
            mixedFibHighBar := na
        else if nextStructureState == STRUCTURE_MIXED
            bool enteringMixed = currentStructureState != STRUCTURE_MIXED
            isFirstMixedTransition := enteringMixed
            if enteringMixed
                mixedAnchorTrendState := previousConfirmedTrendState
                mixedFibPairValid := false
                mixedFibLow := na
                mixedFibLowBar := na
                mixedFibHigh := na
                mixedFibHighBar := na

                if mixedAnchorTrendState == STRUCTURE_BULL and array.size(pivotState.allHighs) > 0 and array.size(pivotState.allLows) > 0
                    for lowIndex = array.size(pivotState.allLows) - 1 to 0
                        int candidateLowBar = array.get(pivotState.allLowBars, lowIndex)
                        float candidateLowPrice = array.get(pivotState.allLows, lowIndex)

                        for highIndex = array.size(pivotState.allHighs) - 1 to 0
                            int candidateHighBar = array.get(pivotState.allHighBars, highIndex)
                            if candidateHighBar < candidateLowBar
                                mixedFibLow := candidateLowPrice
                                mixedFibLowBar := candidateLowBar
                                mixedFibHigh := array.get(pivotState.allHighs, highIndex)
                                mixedFibHighBar := candidateHighBar
                                mixedFibPairValid := true
                                break

                        if mixedFibPairValid
                            break
                else if mixedAnchorTrendState == STRUCTURE_BEAR and array.size(pivotState.allHighs) > 0 and array.size(pivotState.allLows) > 0
                    for highIndex = array.size(pivotState.allHighs) - 1 to 0
                        int candidateHighBar = array.get(pivotState.allHighBars, highIndex)
                        float candidateHighPrice = array.get(pivotState.allHighs, highIndex)

                        for lowIndex = array.size(pivotState.allLows) - 1 to 0
                            int candidateLowBar = array.get(pivotState.allLowBars, lowIndex)
                            if candidateLowBar < candidateHighBar
                                mixedFibLow := array.get(pivotState.allLows, lowIndex)
                                mixedFibLowBar := candidateLowBar
                                mixedFibHigh := candidateHighPrice
                                mixedFibHighBar := candidateHighBar
                                mixedFibPairValid := true
                                break

                        if mixedFibPairValid
                            break

            currentStructureState := STRUCTURE_MIXED
        else
            currentStructureState := STRUCTURE_UNKNOWN
            mixedAnchorTrendState := STRUCTURE_UNKNOWN
            isFirstMixedTransition := false
            mixedFibPairValid := false
            mixedFibLow := na
            mixedFibLowBar := na
            mixedFibHigh := na
            mixedFibHighBar := na

        refreshPivotLabels()
        fib618Value := na
        fib1618Value := na
        fib66Value := na
        fib50Value := na
        fib1382Value := na
        clearFibObjects()
        fib618Line := na
        fib1618Line := na
        fib66Line := na
        fib50Line := na
        fib1382Line := na
        fib618Label := na
        fib1618Label := na
        fib66Label := na
        fib50Label := na
        fib1382Label := na

        if showFib
            bool hasActiveFibPair = false
            float activeFibLow = na
            int activeFibLowBar = na
            float activeFibHigh = na
            int activeFibHighBar = na

            if currentStructureState == STRUCTURE_BULL and array.size(pivotState.allHighs) > 0 and array.size(pivotState.allLows) > 0
                for highIndex = array.size(pivotState.allHighs) - 1 to 0
                    int candidateHighBar = array.get(pivotState.allHighBars, highIndex)
                    float candidateHighPrice = array.get(pivotState.allHighs, highIndex)

                    for lowIndex = array.size(pivotState.allLows) - 1 to 0
                        int candidateLowBar = array.get(pivotState.allLowBars, lowIndex)
                        if candidateLowBar < candidateHighBar
                            activeFibLow := array.get(pivotState.allLows, lowIndex)
                            activeFibLowBar := candidateLowBar
                            activeFibHigh := candidateHighPrice
                            activeFibHighBar := candidateHighBar
                            hasActiveFibPair := true
                            break

                    if hasActiveFibPair
                        break
            else if currentStructureState == STRUCTURE_BEAR and array.size(pivotState.allHighs) > 0 and array.size(pivotState.allLows) > 0
                for lowIndex = array.size(pivotState.allLows) - 1 to 0
                    int candidateLowBar = array.get(pivotState.allLowBars, lowIndex)
                    float candidateLowPrice = array.get(pivotState.allLows, lowIndex)

                    for highIndex = array.size(pivotState.allHighs) - 1 to 0
                        int candidateHighBar = array.get(pivotState.allHighBars, highIndex)
                        if candidateHighBar < candidateLowBar
                            activeFibLow := candidateLowPrice
                            activeFibLowBar := candidateLowBar
                            activeFibHigh := array.get(pivotState.allHighs, highIndex)
                            activeFibHighBar := candidateHighBar
                            hasActiveFibPair := true
                            break

                    if hasActiveFibPair
                        break
            else if currentStructureState == STRUCTURE_MIXED and isFirstMixedTransition and mixedFibPairValid
                hasActiveFibPair := true
                activeFibLow := mixedFibLow
                activeFibLowBar := mixedFibLowBar
                activeFibHigh := mixedFibHigh
                activeFibHighBar := mixedFibHighBar

            if hasActiveFibPair
                int fibStartX = bar_index - 1
                int fibEndX = bar_index + fibExtendBars
                int fibCenterX = int(math.round((fibStartX + fibEndX) / 2.0))
                float logHigh = math.log(activeFibHigh)
                float logLow = math.log(activeFibLow)
                float logRange = math.abs(logHigh - logLow)
                bool activeFibIsBullish = activeFibHighBar > activeFibLowBar

                float logFib618 = activeFibIsBullish ? logHigh - logRange * 0.618 : logLow + logRange * 0.618
                float logFib1618 = activeFibIsBullish ? logHigh + logRange * 0.618 : logLow - logRange * 0.618
                float logFib66 = activeFibIsBullish ? logHigh - logRange * 0.66 : logLow + logRange * 0.66
                float logFib50 = activeFibIsBullish ? logHigh - logRange * 0.5 : logLow + logRange * 0.5
                float logFib1382 = activeFibIsBullish ? logHigh + logRange * 0.382 : logLow - logRange * 0.382

                float fib618 = math.exp(logFib618)
                float fib1618 = math.exp(logFib1618)
                float fib66 = math.exp(logFib66)
                float fib50 = math.exp(logFib50)
                float fib1382 = math.exp(logFib1382)

                fib618Value := fib618
                fib1618Value := fib1618
                fib66Value := fib66
                fib50Value := fib50
                fib1382Value := fib1382

                fib618Line := line.new(fibStartX, fib618, fibEndX, fib618, color=color.blue, style=line.style_dashed, extend=extend.right)
                fib1618Line := line.new(fibStartX, fib1618, fibEndX, fib1618, color=color.blue, style=line.style_dashed, extend=extend.right)
                fib66Line := line.new(fibStartX, fib66, fibEndX, fib66, color=color.blue, style=line.style_dashed, extend=extend.right)
                fib50Line := line.new(fibStartX, fib50, fibEndX, fib50, color=color.blue, style=line.style_dashed, extend=extend.right)
                fib1382Line := line.new(fibStartX, fib1382, fibEndX, fib1382, color=color.blue, style=line.style_dashed, extend=extend.right)

                fib618Label := label.new(fibCenterX, fib618, "0.618", color=color.new(color.blue, 70), style=label.style_label_left, textcolor=color.white, size=size.normal, tooltip="[0.618] " + str.tostring(fib618, format.mintick))
                fib1618Label := label.new(fibCenterX, fib1618, "1.618", color=color.new(color.blue, 70), style=label.style_label_left, textcolor=color.white, size=size.normal, tooltip="[1.618] " + str.tostring(fib1618, format.mintick))
                fib66Label := label.new(fibCenterX, fib66, "0.66", color=color.new(color.blue, 70), style=label.style_label_left, textcolor=color.white, size=size.normal, tooltip="[0.66] " + str.tostring(fib66, format.mintick))
                fib50Label := label.new(fibCenterX, fib50, "0.5", color=color.new(color.blue, 70), style=label.style_label_left, textcolor=color.white, size=size.normal, tooltip="[0.5] " + str.tostring(fib50, format.mintick))
                fib1382Label := label.new(fibCenterX, fib1382, "1.382", color=color.new(color.blue, 70), style=label.style_label_left, textcolor=color.white, size=size.normal, tooltip="[1.382] " + str.tostring(fib1382, format.mintick))
    else if not showFib
        fib618Value := na
        fib1618Value := na
        fib66Value := na
        fib50Value := na
        fib1382Value := na
        clearFibObjects()
        fib618Line := na
        fib1618Line := na
        fib66Line := na
        fib50Line := na
        fib1382Line := na
        fib618Label := na
        fib1618Label := na
        fib66Label := na
        fib50Label := na
        fib1382Label := na

    int tdMarkerLimit = tdseq.markerLimit(tdLength)

    if showTD and tdseq.isMarker(tdBullishSetupCount, tdMarkerLimit)
        if isTdBarSpacingMode()
            label.new(bar_index, na, str.tostring(tdBullishSetupCount), color=tdseq.bearLabelColor(tdBullishSetupCount), style=label.style_text_outline, textcolor=tdseq.bearTextColor(tdBullishSetupCount), size=getTdLabelSize(), tooltip="TD 空方計數: " + str.tostring(tdBullishSetupCount), yloc=yloc.abovebar)
        else
            label.new(bar_index, high + getFixedHlOffset(), str.tostring(tdBullishSetupCount), color=tdseq.bearLabelColor(tdBullishSetupCount), style=label.style_text_outline, textcolor=tdseq.bearTextColor(tdBullishSetupCount), size=getTdLabelSize(), tooltip="TD 空方計數: " + str.tostring(tdBullishSetupCount))

    if showTD and tdseq.isMarker(tdBearishSetupCount, tdMarkerLimit)
        if isTdBarSpacingMode()
            label.new(bar_index, na, str.tostring(tdBearishSetupCount), color=tdseq.bullLabelColor(tdBearishSetupCount), style=label.style_text_outline, textcolor=tdseq.bullTextColor(tdBearishSetupCount), size=getTdLabelSize(), tooltip="TD 多方計數: " + str.tostring(tdBearishSetupCount), yloc=yloc.belowbar)
        else
            label.new(bar_index, low - getFixedHlOffset(), str.tostring(tdBearishSetupCount), color=tdseq.bullLabelColor(tdBearishSetupCount), style=label.style_text_outline, textcolor=tdseq.bullTextColor(tdBearishSetupCount), size=getTdLabelSize(), tooltip="TD 多方計數: " + str.tostring(tdBearishSetupCount))

// 與最近高低點的距離
float distanceToHigh = not na(pivotState.lastHigh) ? (pivotState.lastHigh - close) / close * 100 : na
float distanceToLow = not na(pivotState.lastLow) ? (close - pivotState.lastLow) / close * 100 : na

// 保留數值供資料視窗或後續策略整合使用
plot(distanceToHigh, "距離最近高點 (%)", color=color.new(color.red, 100), display=display.data_window)
plot(distanceToLow, "距離最近低點 (%)", color=color.new(color.green, 100), display=display.data_window)
plot(fib618Value, "[0.618]", color=color.new(color.blue, 100), display=display.data_window)
plot(fib66Value, "[0.66]", color=color.new(color.blue, 100), display=display.data_window)
plot(fib50Value, "[0.5]", color=color.new(color.blue, 100), display=display.data_window)
plot(fib1382Value, "[1.382]", color=color.new(color.blue, 100), display=display.data_window)
plot(fib1618Value, "[1.618]", color=color.new(color.blue, 100), display=display.data_window)

if barstate.islast and showSystemSummaryTable
    string summaryText = "𖤐  大(P)定方向，只順勢\n𖤐  中(P)找回撤與結構\n𖤐  小(P)等再啟動\n𖤐  小(P)混合＝先等\n𖤐  HH / HL 或 LH / LL 才進\n𖤐  止損放 swing 外\n𖤐  ！！只做回撤！！"
    table.cell(summaryTable, 0, 0, summaryText, text_color=color.white, text_size=size.normal, text_halign=text.align_left, bgcolor=color.new(color.black, 25))
else if barstate.islast
    table.clear(summaryTable, 0, 0)

if barstate.islast and showInfoPanel
    string infoText = ""
    if showInfoStructureDirection
        infoText := "結構方向: " + getCurrentStructureDirection()
    if showInfoTimeframe
        infoText := str.length(infoText) > 0 ? infoText + "\n週期: " + timeframe.period : "週期: " + timeframe.period
