tdLength = input.int(9, "TD 序列長度", minval=1, tooltip="TD Setup 的目標計數長度")
tdLabelSizeInput = input.string("中", "TD 計數字體大小", options=["大", "中", "小"], tooltip="大=Large、中=Normal、小=Small")
showInfoPanel = input.bool(true, "顯示資訊面板", tooltip="顯示右上角 TD 與 HL 距離資訊")
showInfoStructureDirection = input.bool(true, "資訊面板顯示結構方向")
showInfoTimeframe = input.bool(false, "資訊面板顯示週期")
showSystemSummaryTable = input.bool(false, "顯示交易系統摘要")
