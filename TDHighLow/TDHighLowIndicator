var array<label> highTriangleLabels = array.new_label()
var array<label> lowTriangleLabels = array.new_label()
var array<label> highStructureLabels = array.new_label()
var array<label> lowStructureLabels = array.new_label()
var bool previousShowAllHL = showAllHL
var bool previousShowLabels = showLabels
var string previousHlLabelDisplayMode = hlLabelDisplayMode
var bool previousShowStructureLabels = showStructureLabels
var bool previousShowStructureBarCount = showStructureBarCount
var int currentStructureState = STRUCTURE_UNKNOWN
var int previousConfirmedTrendState = STRUCTURE_UNKNOWN
var int mixedAnchorTrendState = STRUCTURE_UNKNOWN
