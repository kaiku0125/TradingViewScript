var int tdBearishSetupCount = 0

// 輔助函式
trimPivotLabels(array<label> labels) =>
    if array.size(labels) > MAX_PIVOTS
        label.delete(array.shift(labels))

clearPivotLabels(array<label> labels) =>
    while array.size(labels) > 0
        label.delete(array.pop(labels))

getAutoHlOffsetMultiplier() =>
    string currentPeriod = timeframe.period
    float autoDistance = 0.16

    if currentPeriod == "5"
        autoDistance := 0.10
    else if currentPeriod == "15"
        autoDistance := 0.12
    else if currentPeriod == "60"
        autoDistance := 0.14
    else if currentPeriod == "240"
        autoDistance := 0.16
    else if currentPeriod == "D"
        autoDistance := 0.18
    else if currentPeriod == "3D"
        autoDistance := 0.20
    else if currentPeriod == "W"
        autoDistance := 0.22
    else if currentPeriod == "M"
        autoDistance := 0.24

    autoDistance

getEffectiveHlOffsetMultiplier() =>
    useAutoHlLabelDistance ? getAutoHlOffsetMultiplier() : hlLabelDistance

getFixedHlOffset() =>
    math.max(ta.atr(hlLabelAtrLength) * getEffectiveHlOffsetMultiplier(), syminfo.mintick * 16)

isTdBarSpacingMode() =>
    tdLabelDisplayMode == "Bar 間距顯示"

// TD 計數標籤字體（大／中／小 對應 TradingView size）
getTdLabelSize() =>
    tdLabelSizeInput == "大" ? size.large : tdLabelSizeInput == "小" ? size.small : size.normal

isHlBarSpacingMode() =>
    hlLabelDisplayMode == "Bar 間距顯示"

getHighLabelY(float pivotPrice, int barsAgo) =>
    pivotPrice + getFixedHlOffset()

getLowLabelY(float pivotPrice, int barsAgo) =>
    pivotPrice - getFixedHlOffset()

getStructureTextMultiplier(string currentPeriod, bool isHigh) =>
    float multiplier = isHigh ? 0.35 : 0.75

    if currentPeriod == "5"
        multiplier := isHigh ? 0.70 : 1.35
    else if currentPeriod == "15"
        multiplier := isHigh ? 0.60 : 1.20
    else if currentPeriod == "60"
        multiplier := isHigh ? 0.55 : 1.05
    else if currentPeriod == "240"
        multiplier := isHigh ? 0.45 : 0.90

    multiplier

getStructureLabelY(bool isHigh, float pivotPrice, int barsAgo) =>
    isHigh ? getHighLabelY(pivotPrice, barsAgo) : getLowLabelY(pivotPrice, barsAgo)

getHighStructureTextOffset() =>
    getFixedHlOffset() * getStructureTextMultiplier(timeframe.period, true)

getLowStructureTextOffset() =>
    getFixedHlOffset() * getStructureTextMultiplier(timeframe.period, false)

getStructureTextY(bool isHigh, float pivotPrice, int barsAgo) =>
    float baseY = getStructureLabelY(isHigh, pivotPrice, barsAgo)
    isHigh ? baseY + getHighStructureTextOffset() : baseY - getLowStructureTextOffset()

formatStructureText(string structureText, int barCount) =>
    if str.length(structureText) == 0
        ""
    else if showStructureBarCount and not na(barCount)
        structureText + "(" + str.tostring(barCount) + ")"
    else
        structureText

createHighLabel(int pivotBar, float pivotPrice, int barsAgo) =>
    isHlBarSpacingMode() ?
         label.new(pivotBar, pivotPrice, "", color=highPivotColor, style=label.style_triangledown, textcolor=color.white, size=size.tiny, tooltip="高點價位: " + str.tostring(pivotPrice, format.mintick), yloc=yloc.abovebar) :
         label.new(pivotBar, getHighLabelY(pivotPrice, barsAgo), "", color=highPivotColor, style=label.style_triangledown, textcolor=color.white, size=size.tiny, tooltip="高點價位: " + str.tostring(pivotPrice, format.mintick))

createLowLabel(int pivotBar, float pivotPrice, int barsAgo) =>
    isHlBarSpacingMode() ?
         label.new(pivotBar, pivotPrice, "", color=lowPivotColor, style=label.style_triangleup, textcolor=color.white, size=size.tiny, tooltip="低點價位: " + str.tostring(pivotPrice, format.mintick), yloc=yloc.belowbar) :
         label.new(pivotBar, getLowLabelY(pivotPrice, barsAgo), "", color=lowPivotColor, style=label.style_triangleup, textcolor=color.white, size=size.tiny, tooltip="低點價位: " + str.tostring(pivotPrice, format.mintick))

createStructureLabel(bool isHigh, int pivotBar, float pivotPrice, int barsAgo, string structureText, int barCount) =>
    string displayText = formatStructureText(structureText, barCount)
    if str.length(displayText) == 0
        na
    else if isHlBarSpacingMode()
        label.new(pivotBar, getStructureTextY(isHigh, pivotPrice, barsAgo), displayText, color=color.new(color.black, 100), style=label.style_none, textcolor=color.white, size=size.small)
    else
        label.new(pivotBar, getStructureTextY(isHigh, pivotPrice, barsAgo), displayText, color=color.new(color.black, 100), style=label.style_none, textcolor=color.white, size=size.small)

getCurrentStructureDirection() =>
    if currentStructureState == STRUCTURE_BULL
        "多頭延續"
    else if currentStructureState == STRUCTURE_BEAR
        "空頭延續"
    else if currentStructureState == STRUCTURE_MIXED
        if isFirstMixedTransition and mixedAnchorTrendState == STRUCTURE_BULL
            "混合(由多頭轉弱)"
        else if isFirstMixedTransition and mixedAnchorTrendState == STRUCTURE_BEAR
            "混合(由空頭轉強)"
        else
            "混合"
    else
        "未定"

getStructureStateFromStructures() =>
    string lastHighStructure = array.size(pivotState.allHighStructures) > 0 ? array.get(pivotState.allHighStructures, array.size(pivotState.allHighStructures) - 1) : ""
    string lastLowStructure = array.size(pivotState.allLowStructures) > 0 ? array.get(pivotState.allLowStructures, array.size(pivotState.allLowStructures) - 1) : ""

    if lastHighStructure == "HH" and lastLowStructure == "HL"
        STRUCTURE_BULL
    else if lastHighStructure == "LH" and lastLowStructure == "LL"
        STRUCTURE_BEAR
    else if str.length(lastHighStructure) == 0 or str.length(lastLowStructure) == 0
        STRUCTURE_UNKNOWN
    else
        STRUCTURE_MIXED

findLatestBullishFibPair() =>
    bool foundPair = false
    float pairLowPrice = na
    int pairLowBar = na
    float pairHighPrice = na
    int pairHighBar = na

    if array.size(pivotState.allHighs) > 0 and array.size(pivotState.allLows) > 0
        for highIndex = array.size(pivotState.allHighs) - 1 to 0
            int candidateHighBar = array.get(pivotState.allHighBars, highIndex)
            float candidateHighPrice = array.get(pivotState.allHighs, highIndex)

            for lowIndex = array.size(pivotState.allLows) - 1 to 0
                int candidateLowBar = array.get(pivotState.allLowBars, lowIndex)
                if candidateLowBar < candidateHighBar
                    pairLowPrice := array.get(pivotState.allLows, lowIndex)
                    pairLowBar := candidateLowBar
                    pairHighPrice := candidateHighPrice
                    pairHighBar := candidateHighBar
                    foundPair := true
                    break

            if foundPair
                break

    [foundPair, pairLowPrice, pairLowBar, pairHighPrice, pairHighBar]

findLatestBearishFibPair() =>
    bool foundPair = false
    float pairLowPrice = na
    int pairLowBar = na
    float pairHighPrice = na
    int pairHighBar = na

    if array.size(pivotState.allHighs) > 0 and array.size(pivotState.allLows) > 0
        for lowIndex = array.size(pivotState.allLows) - 1 to 0
            int candidateLowBar = array.get(pivotState.allLowBars, lowIndex)
            float candidateLowPrice = array.get(pivotState.allLows, lowIndex)

            for highIndex = array.size(pivotState.allHighs) - 1 to 0
                int candidateHighBar = array.get(pivotState.allHighBars, highIndex)
                if candidateHighBar < candidateLowBar
                    pairLowPrice := candidateLowPrice
                    pairLowBar := candidateLowBar
                    pairHighPrice := array.get(pivotState.allHighs, highIndex)
                    pairHighBar := candidateHighBar
                    foundPair := true
                    break

            if foundPair
                break

    [foundPair, pairLowPrice, pairLowBar, pairHighPrice, pairHighBar]

