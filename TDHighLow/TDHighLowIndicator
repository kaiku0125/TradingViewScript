depthInput = input.int(12, "Depth", minval=1, tooltip="用於偵測 ZigZag 高低點的回看深度")
deviationInput = input.int(5, "Deviation", minval=1, tooltip="兩個高低點之間至少要有的最小價格差，單位為最小跳動")
backstepInput = input.int(3, "Backstep", minval=2, tooltip="高低點確認時所需的最少回退 K 棒數")

useAutoHlLabelDistance = input.bool(true, "自動 HL 標籤距離", tooltip="依照常用週期自動套用 High/Low 標籤距離")
hlLabelAtrLength = input.int(14, "HL 標籤波動週期", minval=1, tooltip="用 ATR 計算 High/Low 標籤與 K 棒的基礎距離")
hlLabelDistance = input.float(0.30, "HL 標籤距離倍率", minval=0.05, step=0.05, tooltip="關閉自動 HL 標籤距離時使用的預設倍率")

// ZigZag 式 Pivot 計算
float zigHighPoint = ta.pivothigh(high, depthInput, backstepInput)
