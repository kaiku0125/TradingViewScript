tdLabelDisplayMode = input.string("Bar 間距顯示", "TD 標籤顯示方式", options=["Bar 間距顯示", "固定價格偏移"], tooltip="切換 TD 序列標籤使用 TradingView 內建 Bar 間距，或固定價格偏移")
