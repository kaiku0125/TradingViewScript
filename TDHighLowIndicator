//@version=5

indicator("TD高低點", overlay=true, max_labels_count=500, max_lines_count=200)

const int MAX_PIVOTS = 20
const int MAX_HISTORY_LABELS = 10

// 輸入參數
lookbackPeriod = input.int(5, "回看週期", minval=1, tooltip="用於識別高低點的週期數，加密貨幣建議 3 至 7 天")
minPivotDistance = input.int(5, "最小距離", minval=1, tooltip="兩個同類型高低點之間的最小 Bar 距離")
showLabels = input.bool(true, "顯示高低點標籤")
showAllHL = input.bool(false, "顯示歷史高低點", tooltip="開啟後顯示最近一批歷史高低點，關閉則只顯示最新高低點")
showTD = input.bool(true, "顯示 TD 序列", tooltip="顯示 TD Setup 的關鍵計數")
tdLength = input.int(9, "TD 序列長度", minval=1, tooltip="TD Setup 的目標計數長度")
showInfoPanel = input.bool(false, "顯示資訊面板", tooltip="顯示右上角 TD 與 HL 距離資訊")
useAutoHlLabelDistance = input.bool(true, "自動 HL 標籤距離", tooltip="依照常用週期自動套用 High/Low 標籤距離")
hlLabelAtrLength = input.int(14, "HL 標籤波動週期", minval=1, tooltip="用 ATR 計算 High/Low 標籤與 K 棒的基礎距離")
hlLabelDistance = input.float(0.30, "HL 標籤距離倍率", minval=0.05, step=0.05, tooltip="關閉自動 HL 標籤距離時使用的預設倍率")
showFib = input.bool(true, "顯示斐波那契", tooltip="顯示最近一組高低點推導出的斐波那契水平")

// Pivot 計算
highPoint = ta.pivothigh(high, lookbackPeriod, lookbackPeriod)
lowPoint = ta.pivotlow(low, lookbackPeriod, lookbackPeriod)

// 最近高低點資料
var float lastHigh = na
var float lastLow = na
var int lastHighBar = na
var int lastLowBar = na

// 歷史高低點資料
var array<float> allHighs = array.new_float()
var array<float> allLows = array.new_float()
var array<int> allHighBars = array.new_int()
var array<int> allLowBars = array.new_int()

// 斐波那契物件
var line fib618Line = na
var line fib1618Line = na
var line fib66Line = na
var line fib1382Line = na
var label fib618Label = na
var label fib1618Label = na
var label fib66Label = na
var label fib1382Label = na
var float fib618Value = na
var float fib1618Value = na
var float fib66Value = na
var float fib1382Value = na
var table tdInfoTable = table.new(position.top_right, 1, 1)
var float highPlotY = na
var float lowPlotY = na
var float latestHighPlotY = na
var float latestLowPlotY = na

// TD Setup 計數
var int tdBullishSetupCount = 0
var int tdBearishSetupCount = 0

// 輔助函式
isValidPivotDistance(int previousBar, int currentBar, int minBars) =>
    na(previousBar) or currentBar - previousBar >= minBars

trimPivotData(array<float> prices, array<int> bars) =>
    if array.size(prices) > MAX_PIVOTS
        array.shift(prices)
        array.shift(bars)

isTdMarker(int count, int maxCount) =>
    ((count >= 7 and count <= 9) or (count >= 11 and count <= 13)) and count <= maxCount

getBearTdLabelColor(int count) =>
    count == 9 or count == 13 ? color.rgb(255, 59, 59) : color.new(color.rgb(90, 32, 32), 15)

getBearTdTextColor(int count) =>
    count == 11 or count == 12 ? color.new(color.white, 20) : color.white

getBullTdLabelColor(int count) =>
    count == 9 or count == 13 ? color.rgb(76, 175, 80) : color.new(color.rgb(44, 84, 52), 10)

getBullTdTextColor(int count) =>
    count == 11 or count == 12 ? color.new(color.white, 20) : color.white

getAutoHlLabelDistance() =>
    string currentPeriod = timeframe.period
    float autoDistance = 0.30

    if currentPeriod == "15"
        autoDistance := 0.22
    else if currentPeriod == "60"
        autoDistance := 0.26
    else if currentPeriod == "240"
        autoDistance := 0.32
    else if currentPeriod == "D"
        autoDistance := 0.38
    else if currentPeriod == "3D"
        autoDistance := 0.46
    else if currentPeriod == "W"
        autoDistance := 0.58
    else if currentPeriod == "M"
        autoDistance := 0.72

    autoDistance

getEffectiveHlLabelDistance() =>
    useAutoHlLabelDistance ? getAutoHlLabelDistance() : hlLabelDistance

getHlLabelOffset() =>
    math.max(ta.atr(hlLabelAtrLength) * getEffectiveHlLabelDistance(), syminfo.mintick * 40)

getHighLabelY(float pivotPrice, int barsAgo) =>
    int tdMarkerLimit = math.max(tdLength, 13)
    int pastBearTdCount = int(nz(tdBullishSetupCount[barsAgo]))
    bool hasTdMarkerConflict = isTdMarker(pastBearTdCount, tdMarkerLimit)
    float hlOffset = getHlLabelOffset()
    pivotPrice + hlOffset * (hasTdMarkerConflict ? 4.2 : 2.4)

getLowLabelY(float pivotPrice, int barsAgo) =>
    int tdMarkerLimit = math.max(tdLength, 13)
    int pastBullTdCount = int(nz(tdBearishSetupCount[barsAgo]))
    bool hasTdMarkerConflict = isTdMarker(pastBullTdCount, tdMarkerLimit)
    float hlOffset = getHlLabelOffset()
    pivotPrice - hlOffset * (hasTdMarkerConflict ? 4.2 : 2.4)

if barstate.isconfirmed
    bool hasNewPivot = false
    highPlotY := na
    lowPlotY := na

    if not na(highPoint)
        int pivotBar = bar_index - lookbackPeriod
        if isValidPivotDistance(lastHighBar, pivotBar, minPivotDistance)
            lastHigh := highPoint
            lastHighBar := pivotBar
            array.push(allHighs, highPoint)
            array.push(allHighBars, pivotBar)
            trimPivotData(allHighs, allHighBars)
            hasNewPivot := true

            if showLabels
                float labelY = getHighLabelY(highPoint, lookbackPeriod)
                highPlotY := labelY
                latestHighPlotY := labelY

    if not na(lowPoint)
        int pivotBar = bar_index - lookbackPeriod
        if isValidPivotDistance(lastLowBar, pivotBar, minPivotDistance)
            lastLow := lowPoint
            lastLowBar := pivotBar
            array.push(allLows, lowPoint)
            array.push(allLowBars, pivotBar)
            trimPivotData(allLows, allLowBars)
            hasNewPivot := true

            if showLabels
                float labelY = getLowLabelY(lowPoint, lookbackPeriod)
                lowPlotY := labelY
                latestLowPlotY := labelY

    if hasNewPivot
        fib618Value := na
        fib1618Value := na
        fib66Value := na
        fib1382Value := na

        if not na(fib618Line)
            line.delete(fib618Line)
            fib618Line := na
        if not na(fib1618Line)
            line.delete(fib1618Line)
            fib1618Line := na
        if not na(fib66Line)
            line.delete(fib66Line)
            fib66Line := na
        if not na(fib1382Line)
            line.delete(fib1382Line)
            fib1382Line := na
        if not na(fib618Label)
            label.delete(fib618Label)
            fib618Label := na
        if not na(fib1618Label)
            label.delete(fib1618Label)
            fib1618Label := na
        if not na(fib66Label)
            label.delete(fib66Label)
            fib66Label := na
        if not na(fib1382Label)
            label.delete(fib1382Label)
            fib1382Label := na

        if showFib and not na(lastHigh) and not na(lastLow)
            float logHigh = math.log(lastHigh)
            float logLow = math.log(lastLow)
            float logRange = math.abs(logHigh - logLow)
            bool lastPivotIsHigh = lastHighBar > lastLowBar

            float logFib618 = lastPivotIsHigh ? logHigh - logRange * 0.618 : logLow + logRange * 0.618
            float logFib1618 = lastPivotIsHigh ? logHigh + logRange * 0.618 : logLow - logRange * 0.618
            float logFib66 = lastPivotIsHigh ? logHigh - logRange * 0.66 : logLow + logRange * 0.66
            float logFib1382 = lastPivotIsHigh ? logHigh + logRange * 0.382 : logLow - logRange * 0.382

            float fib618 = math.exp(logFib618)
            float fib1618 = math.exp(logFib1618)
            float fib66 = math.exp(logFib66)
            float fib1382 = math.exp(logFib1382)

            fib618Value := fib618
            fib1618Value := fib1618
            fib66Value := fib66
            fib1382Value := fib1382

            fib618Line := line.new(bar_index - 1, fib618, bar_index + 100, fib618, color=color.blue, style=line.style_dashed, extend=extend.right)
            fib1618Line := line.new(bar_index - 1, fib1618, bar_index + 100, fib1618, color=color.blue, style=line.style_dashed, extend=extend.right)
            fib66Line := line.new(bar_index - 1, fib66, bar_index + 100, fib66, color=color.blue, style=line.style_dashed, extend=extend.right)
            fib1382Line := line.new(bar_index - 1, fib1382, bar_index + 100, fib1382, color=color.blue, style=line.style_dashed, extend=extend.right)

            fib618Label := label.new(bar_index, fib618, "0.618", color=color.new(color.blue, 70), style=label.style_label_left, textcolor=color.white, size=size.small, tooltip="[0.618] " + str.tostring(fib618, format.mintick))
            fib1618Label := label.new(bar_index, fib1618, "1.618", color=color.new(color.blue, 70), style=label.style_label_left, textcolor=color.white, size=size.small, tooltip="[1.618] " + str.tostring(fib1618, format.mintick))
            fib66Label := label.new(bar_index, fib66, "0.66", color=color.new(color.blue, 70), style=label.style_label_left, textcolor=color.white, size=size.small, tooltip="[0.66] " + str.tostring(fib66, format.mintick))
            fib1382Label := label.new(bar_index, fib1382, "1.382", color=color.new(color.blue, 70), style=label.style_label_left, textcolor=color.white, size=size.small, tooltip="[1.382] " + str.tostring(fib1382, format.mintick))

    tdBullishSetupCount := close > close[4] ? tdBullishSetupCount + 1 : 0
    tdBearishSetupCount := close < close[4] ? tdBearishSetupCount + 1 : 0

    int tdMarkerLimit = math.max(tdLength, 13)

    if showTD and isTdMarker(tdBullishSetupCount, tdMarkerLimit)
        label.new(
             bar_index,
             na,
             str.tostring(tdBullishSetupCount),
             color=getBearTdLabelColor(tdBullishSetupCount),
             style=label.style_text_outline,
             textcolor=getBearTdTextColor(tdBullishSetupCount),
             size=size.large,
             tooltip="TD 空方計數: " + str.tostring(tdBullishSetupCount),
             yloc=yloc.abovebar
         )

    if showTD and isTdMarker(tdBearishSetupCount, tdMarkerLimit)
        label.new(
             bar_index,
             na,
             str.tostring(tdBearishSetupCount),
             color=getBullTdLabelColor(tdBearishSetupCount),
             style=label.style_text_outline,
             textcolor=getBullTdTextColor(tdBearishSetupCount),
             size=size.large,
             tooltip="TD 多方計數: " + str.tostring(tdBearishSetupCount),
             yloc=yloc.belowbar
         )

// 與最近高低點的距離
float distanceToHigh = not na(lastHigh) ? (lastHigh - close) / close * 100 : na
float distanceToLow = not na(lastLow) ? (close - lastLow) / close * 100 : na

// 保留數值供資料視窗或後續策略整合使用
plot(distanceToHigh, "距離最近高點 (%)", color=color.new(color.red, 100), display=display.data_window)
plot(distanceToLow, "距離最近低點 (%)", color=color.new(color.green, 100), display=display.data_window)
plot(fib618Value, "[0.618]", color=color.new(color.blue, 100), display=display.data_window)
plot(fib66Value, "[0.66]", color=color.new(color.blue, 100), display=display.data_window)
plot(fib1382Value, "[1.382]", color=color.new(color.blue, 100), display=display.data_window)
plot(fib1618Value, "[1.618]", color=color.new(color.blue, 100), display=display.data_window)

plotshape(showLabels and showAllHL ? highPlotY : na, "歷史高點", shape.triangledown, location.absolute, color.green, offset=-lookbackPeriod, size=size.small)
plotshape(showLabels and showAllHL ? lowPlotY : na, "歷史低點", shape.triangleup, location.absolute, color.red, offset=-lookbackPeriod, size=size.small)
plotshape(showLabels and not showAllHL and barstate.islast ? latestHighPlotY : na, "最新高點", shape.triangledown, location.absolute, color.green, offset=lastHighBar - bar_index, size=size.small)
plotshape(showLabels and not showAllHL and barstate.islast ? latestLowPlotY : na, "最新低點", shape.triangleup, location.absolute, color.red, offset=lastLowBar - bar_index, size=size.small)

if barstate.islast and showInfoPanel
    string hlDistanceMode = useAutoHlLabelDistance ? "自動" : "手動"
    string tdDistanceText = "TD距離\n週期: " + timeframe.period + "\n模式: 固定 Bar 間距\n\nHL距離(" + hlDistanceMode + ")\n倍率: " + str.tostring(getEffectiveHlLabelDistance(), "#.##")
    table.cell(tdInfoTable, 0, 0, tdDistanceText, text_color=color.white, text_size=size.small, bgcolor=color.new(color.black, 35))
else if barstate.islast
    table.clear(tdInfoTable, 0, 0)
