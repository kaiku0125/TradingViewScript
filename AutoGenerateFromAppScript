/* global SpreadsheetApp, Logger */

const HoldingsService = (() => {
  function roundTo(value, digits) {
    const factor = Math.pow(10, digits);
    return Math.round((Number(value) + Number.EPSILON) * factor) / factor;
  }

  function formatNumber(value, digits) {
    return roundTo(value, digits)
      .toFixed(digits)
      .replace(/\.?0+$/, "");
  }

  function getHoldingsData() {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const holdingsSheet = ss.getSheetByName("holdings");

    if (!holdingsSheet) {
      throw new Error('找不到 "holdings" 工作表');
    }

    const data = holdingsSheet.getDataRange().getValues();

    if (data.length < 2) {
      throw new Error('"holdings" 工作表沒有資料');
    }

    const headers = data[0].map(h => String(h).trim());
    const rows = data.slice(1);

    const colIndex = {};
    headers.forEach((header, index) => {
      colIndex[header] = index;
    });

    const requiredColumns = [
      "symbol",
      "buy_qty",
      "buy_cost",
      "sell_qty",
      "sell_income"
    ];

    requiredColumns.forEach(col => {
      if (colIndex[col] === undefined) {
        throw new Error(`holdings 缺少欄位: ${col}`);
      }
    });

    const holdings = rows
      .map(row => ({
        symbol: String(row[colIndex["symbol"]] || "").trim().toUpperCase(),
        buy_qty: Number(formatNumber(row[colIndex["buy_qty"]] || 0, 8)),
        buy_cost: Number(formatNumber(row[colIndex["buy_cost"]] || 0, 2)),
        sell_qty: Number(formatNumber(row[colIndex["sell_qty"]] || 0, 8)),
        sell_income: Number(formatNumber(row[colIndex["sell_income"]] || 0, 2))
      }))
      .filter(item => item.symbol);

    return holdings;
  }

  function getUsdData() {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const usdSheet = ss.getSheetByName("usd");

    if (!usdSheet) {
      throw new Error('找不到 "usd" 工作表');
    }

    const data = usdSheet.getDataRange().getValues();

    if (data.length < 2) {
      throw new Error('"usd" 工作表沒有資料');
    }

    const headers = data[0].map(h => String(h).trim());
    const rows = data.slice(1);

    const colIndex = {};
    headers.forEach((header, index) => {
      colIndex[header] = index;
    });

    const requiredColumns = [
      "exchange",
      "usd_balance"
    ];

    requiredColumns.forEach(col => {
      if (colIndex[col] === undefined) {
        throw new Error(`usd 缺少欄位: ${col}`);
      }
    });

    return rows
      .map(row => ({
        exchange: String(row[colIndex["exchange"]] || "").trim().toLowerCase(),
        usd_balance: Number(formatNumber(row[colIndex["usd_balance"]] || 0, 2))
      }))
      .filter(item => item.exchange);
  }

  function getPortfolioData() {
    return {
      updated_at: new Date().toISOString(),
      holdings: getHoldingsData(),
      usd_balances: getUsdData()
    };
  }

  return {
    getPortfolioData
  };
})();

const TradeHistoryService = (() => {
  const TRADE_HISTORY_TABS = ["006208", "BTC", "ETH", "ADA", "平台幣"];

  function getSheetDisplayValuesOrEmpty(ss, sheetName) {
    const sheet = ss.getSheetByName(sheetName);
    if (!sheet) {
      return [];
    }
    return sheet.getDataRange().getDisplayValues();
  }

  function getTradeHistoryData() {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const tabs = {};

    TRADE_HISTORY_TABS.forEach(sheetName => {
      tabs[sheetName] = getSheetDisplayValuesOrEmpty(ss, sheetName);
    });

    return {
      fetched_at: Utilities.formatDate(
        new Date(),
        "Asia/Taipei",
        "yyyy-MM-dd'T'HH:mm:ssZ"
      ),
      spreadsheet_url: ss.getUrl(),
      tabs
    };
  }

  return {
    getTradeHistoryData
  };
})();

