function doGet(e) {
  const token = e?.parameter?.token;
  const mode = String(e?.parameter?.mode || "holdings").trim().toLowerCase();
  if (token !== "0125") {
    return ContentService
      .createTextOutput(JSON.stringify({ error: "unauthorized" }))
      .setMimeType(ContentService.MimeType.JSON);
  }

  let payload;
  if (mode === "trade_history") {
    payload = TradeHistoryService.getTradeHistoryData();
  } else if (mode === "holdings") {
    payload = HoldingsService.getPortfolioData();
  } else {
    payload = { error: "unsupported_mode", mode };
  }

  return ContentService
    .createTextOutput(JSON.stringify(payload))
    .setMimeType(ContentService.MimeType.JSON);
}
