# Copy this file to .env.local and fill in the values.
# Do not commit .env.local.

# Google Apps Script endpoint for holdings / USD balance sync.
HOLDINGS_WEB_APP_TOKEN=
HOLDINGS_WEB_APP_URL=

# Trade history refresh. Leave blank to reuse HOLDINGS_WEB_APP_TOKEN / default URL.
TRADE_HISTORY_WEB_APP_TOKEN=
TRADE_HISTORY_WEB_APP_URL=

# Telegram weekly summary notification.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notion weekly review sync.
NOTION_TOKEN=
NOTION_PAGE_ID=
NOTION_WEEKLY_REVIEW_ICON=🗓️
