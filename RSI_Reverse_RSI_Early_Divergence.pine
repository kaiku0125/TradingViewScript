//@version=6
indicator(title="[Kaiku] Relative Strength Index with Reverse-RSI Early Divergence", shorttitle="[Kaiku] RSI Early Div", format=format.price, precision=2)

rsiLengthInput = input.int(14, minval=1, title="RSI 長度", group="RSI 設定")
rsiSourceInput = input.source(close, "來源", group="RSI 設定")
calculateDivergence = input.bool(true, title="計算背離", group="RSI 設定", display = display.none, tooltip = "需開啟背離計算，背離警報才會觸發。")

change = ta.change(rsiSourceInput)
up = ta.rma(math.max(change, 0), rsiLengthInput)
down = ta.rma(-math.min(change, 0), rsiLengthInput)
rsi = down == 0 ? 100 : up == 0 ? 0 : 100 - (100 / (1 + up / down))

rsiPlot = plot(rsi, "RSI", color=#7E57C2)
rsiUpperBand = hline(70, "RSI 上軌", color=#787B86)
midline = hline(50, "RSI 中線", color=color.new(#787B86, 50))
rsiLowerBand = hline(30, "RSI 下軌", color=#787B86)
fill(rsiUpperBand, rsiLowerBand, color=color.rgb(126, 87, 194, 90), title="RSI 背景填色")
midLinePlot = plot(50, color = na, editable = false, display = display.none)
fill(rsiPlot, midLinePlot, 100, 70, top_color = color.new(color.green, 0), bottom_color = color.new(color.green, 100),  title = "超買漸層填色")
fill(rsiPlot, midLinePlot, 30,  0,  top_color = color.new(color.red, 100), bottom_color = color.new(color.red, 0),      title = "超賣漸層填色")

// Smoothing MA inputs
GRP = "平滑均線"
TT_BB = "僅在選擇「SMA + 布林通道」時有效，決定 SMA 與通道之間的距離。"
maTypeInput = input.string("SMA", "類型", options = ["無", "SMA", "SMA + 布林通道", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group = GRP, display = display.none)
var isBB = maTypeInput == "SMA + 布林通道"
maLengthInput = input.int(14, "長度", group = GRP, display = display.none, active = maTypeInput != "無")
bbMultInput = input.float(2.0, "布林標準差倍數", minval = 0.001, maxval = 50, step = 0.5, tooltip = TT_BB, group = GRP, display = display.none, active = isBB)
var enableMA = maTypeInput != "無"

// Smoothing MA Calculation
ma(source, length, MAtype) =>
    switch MAtype
        "SMA"                   => ta.sma(source, length)
        "SMA + 布林通道"        => ta.sma(source, length)
        "EMA"                   => ta.ema(source, length)
        "SMMA (RMA)"            => ta.rma(source, length)
        "WMA"                   => ta.wma(source, length)
        "VWMA"                  => ta.vwma(source, length)

// Smoothing MA plots
smoothingMA = enableMA ? ma(rsi, maLengthInput, maTypeInput) : na
smoothingStDev = isBB ? ta.stdev(rsi, maLengthInput) * bbMultInput : na
plot(smoothingMA, "RSI 均線", color=color.yellow, display = enableMA ? display.all : display.none, editable = enableMA)
bbUpperBand = plot(smoothingMA + smoothingStDev, title = "布林上軌", color=color.green, display = isBB ? display.all : display.none, editable = isBB)
bbLowerBand = plot(smoothingMA - smoothingStDev, title = "布林下軌", color=color.green, display = isBB ? display.all : display.none, editable = isBB)
fill(bbUpperBand, bbLowerBand, color= isBB ? color.new(color.green, 90) : na, title="布林通道背景填色", display = isBB ? display.all : display.none, editable = isBB)

// Divergence
lookbackRight = 5
lookbackLeft = 5
rangeUpper = 60
rangeLower = 5
bearColor = color.red
bullColor = color.green
textColor = color.white
noneColor = color.new(color.white, 100)

_inRange(bool cond) =>
    bars = ta.barssince(cond)
    rangeLower <= bars and bars <= rangeUpper

plFound = false
phFound = false

bullCond = false
bearCond = false

rsiLBR = rsi[lookbackRight]
lowLBR = low[lookbackRight]
highLBR = high[lookbackRight]
plFoundRaw = not na(ta.pivotlow(rsi, lookbackLeft, lookbackRight))
phFoundRaw = not na(ta.pivothigh(rsi, lookbackLeft, lookbackRight))

if calculateDivergence
    //------------------------------------------------------------------------------
    // Regular Bullish
    // rsi: Higher Low
    plFound := plFoundRaw
    rsiHL = rsiLBR > ta.valuewhen(plFound, rsiLBR, 1) and _inRange(plFound[1])
    // Price: Lower Low
    priceLL = lowLBR < ta.valuewhen(plFound, lowLBR, 1)
    bullCond := priceLL and rsiHL and plFound

    //------------------------------------------------------------------------------
    // Regular Bearish
    // rsi: Lower High
    phFound := phFoundRaw
    rsiLH = rsiLBR < ta.valuewhen(phFound, rsiLBR, 1) and _inRange(phFound[1])
    // Price: Higher High
    priceHH = highLBR > ta.valuewhen(phFound, highLBR, 1)
    bearCond := priceHH and rsiLH and phFound


plot(
     plFound   ? rsiLBR : na,
     offset    = -lookbackRight,
     title     = "常規看漲背離",
     linewidth = 2,
     color     = (bullCond ? bullColor : noneColor),
     display   = display.pane,
     editable  = calculateDivergence)

plotshape(
     bullCond  ? rsiLBR : na,
     offset    = -lookbackRight,
     title     = "常規看漲背離標籤",
     text      = " Bull ",
     style     = shape.labelup,
     location  = location.absolute,
     color     = bullColor,
     textcolor = textColor,
     display   = display.pane,
     editable  = calculateDivergence)

plot(
     phFound   ? rsiLBR : na,
     offset    = -lookbackRight,
     title     = "常規看跌背離",
     linewidth = 2,
     color     = (bearCond ? bearColor : noneColor),
     display   = display.pane,
     editable  = calculateDivergence)

plotshape(
     bearCond  ? rsiLBR : na,
     offset    = -lookbackRight,
     title     = "常規看跌背離標籤",
     text      = " Bear ",
     style     = shape.labeldown,
     location  = location.absolute,
     color     = bearColor,
     textcolor = textColor,
     display   = display.pane,
     editable  = calculateDivergence)

alertcondition(bullCond, title="常規看漲背離", message="出現新的常規看漲背離，位於目前 K 棒左側第 5 根（樞紐右側回看數）。")
alertcondition(bearCond, title="常規看跌背離", message="出現新的常規看跌背離，位於目前 K 棒左側第 5 根（樞紐右側回看數）。")

// Reverse-RSI Early Divergence
// This is an intrabar early-warning for the newest possible pivot one bar before the
// standard lookbackRight confirmation. It can repaint while the realtime bar is
// moving. The threshold is expressed in the RSI source units, so it is most meaningful
// when Source is close.
earlyDivGroup = "Reverse-RSI 提前背離"
showEarlyDiv = input.bool(true, "顯示提前背離", group = earlyDivGroup)
showEarlyDebug = input.bool(false, "顯示提前背離除錯表", group = earlyDivGroup)
earlyLookbackRight = input.int(4, "提前樞紐右側回看 K 棒數", minval = 1, maxval = 4, group = earlyDivGroup)

f_priceForRSI(float targetRSI) =>
    float result = na
    float targetRS = na
    float prevSource = rsiSourceInput[1]
    float u1 = up[1]
    float d1 = down[1]
    float w = rsiLengthInput - 1.0
    bool validTarget = not na(targetRSI) and targetRSI > 0 and targetRSI < 100
    bool validState = not na(prevSource) and not na(u1) and not na(d1) and not (u1 == 0 and d1 == 0)
    if validTarget and validState
        targetRS := targetRSI / (100.0 - targetRSI)
        if d1 == 0
            result := prevSource + w * (d1 - u1 / targetRS)
        else
            baseRS = u1 / d1
            requiredChange = targetRS >= baseRS ? w * (targetRS * d1 - u1) : w * (d1 - u1 / targetRS)
            result := prevSource + requiredChange
    result

f_formatPrice(float price) =>
    float absPrice = math.abs(price)
    absPrice >= 1000 ? str.tostring(price, "#") :
     absPrice >= 100 ? str.tostring(price, "#.#") :
     absPrice >= 1 ? str.tostring(price, "#.##") :
     absPrice >= 0.1 ? str.tostring(price, "#.####") :
     absPrice >= 0.01 ? str.tostring(price, "#.#####") :
     absPrice >= 0.001 ? str.tostring(price, "#.######") :
     absPrice >= 0.0001 ? str.tostring(price, "#.#######") :
     str.tostring(price, "#.########")

f_boolText(bool value) =>
    value ? "Y" : "N"

prevPLrsi = ta.valuewhen(plFoundRaw, rsiLBR, 0)
prevPLprice = ta.valuewhen(plFoundRaw, lowLBR, 0)
prevPLbar = ta.valuewhen(plFoundRaw, bar_index - lookbackRight, 0)
prevPHrsi = ta.valuewhen(phFoundRaw, rsiLBR, 0)
prevPHprice = ta.valuewhen(phFoundRaw, highLBR, 0)
prevPHbar = ta.valuewhen(phFoundRaw, bar_index - lookbackRight, 0)

earlyRsi = rsi[earlyLookbackRight]
earlyLow = low[earlyLookbackRight]
earlyHigh = high[earlyLookbackRight]

earlyRightConfirmed = earlyLookbackRight - 1
earlyPLRightConfirmed = true
earlyPHRightConfirmed = true
if earlyRightConfirmed > 0
    earlyPLRightConfirmed := earlyRsi <= ta.lowest(rsi[1], earlyRightConfirmed)
    earlyPHRightConfirmed := earlyRsi >= ta.highest(rsi[1], earlyRightConfirmed)
earlyPLCandidate = not na(earlyRsi) and earlyRsi < ta.lowest(rsi[earlyLookbackRight + 1], lookbackLeft) and earlyPLRightConfirmed
earlyPHCandidate = not na(earlyRsi) and earlyRsi > ta.highest(rsi[earlyLookbackRight + 1], lookbackLeft) and earlyPHRightConfirmed

bullFloor = f_priceForRSI(earlyRsi)
bearCap = f_priceForRSI(earlyRsi)

earlyBullRsiHL = earlyRsi > prevPLrsi and _inRange(plFoundRaw)
earlyBullPriceLL = earlyLow < prevPLprice
earlyBullThresholdValid = not na(bullFloor)
bullProtectsPivot = close > bullFloor
bullEarly = earlyPLCandidate and earlyBullPriceLL and earlyBullRsiHL and earlyBullThresholdValid and bullProtectsPivot

earlyBearRsiLH = earlyRsi < prevPHrsi and _inRange(phFoundRaw)
earlyBearPriceHH = earlyHigh > prevPHprice
earlyBearThresholdValid = not na(bearCap)
bearProtectsPivot = close < bearCap
bearEarly = earlyPHCandidate and earlyBearPriceHH and earlyBearRsiLH and earlyBearThresholdValid and bearProtectsPivot

var line earlyBullLine = na
var label earlyBullLabel = na
var float activeBullFloor = na
var int activeBullBar = na
var line earlyBearLine = na
var label earlyBearLabel = na
var float activeBearCap = na
var int activeBearBar = na
var table earlyDebugTable = table.new(position.bottom_right, 2, 7, bgcolor = color.new(color.black, 15), frame_color = color.new(color.white, 75), frame_width = 1)

table.clear(earlyDebugTable, 0, 0, 1, 6)
if showEarlyDebug
    table.cell(earlyDebugTable, 0, 0, "Early", text_color = color.white, bgcolor = color.new(#7E57C2, 0), text_size = size.small)
    table.cell(earlyDebugTable, 1, 0, "c/p/r/t/x", text_color = color.white, bgcolor = color.new(#7E57C2, 0), text_size = size.small)
    table.cell(earlyDebugTable, 0, 1, "Bull " + f_boolText(bullEarly), text_color = bullEarly ? bullColor : color.white, text_size = size.small)
    table.cell(earlyDebugTable, 1, 1, f_boolText(earlyPLCandidate) + "/" + f_boolText(earlyBullPriceLL) + "/" + f_boolText(earlyBullRsiHL) + "/" + f_boolText(earlyBullThresholdValid) + "/" + f_boolText(bullProtectsPivot), text_color = bullEarly ? bullColor : color.white, text_size = size.small)
    table.cell(earlyDebugTable, 0, 2, "Bear " + f_boolText(bearEarly), text_color = bearEarly ? bearColor : color.white, text_size = size.small)
    table.cell(earlyDebugTable, 1, 2, f_boolText(earlyPHCandidate) + "/" + f_boolText(earlyBearPriceHH) + "/" + f_boolText(earlyBearRsiLH) + "/" + f_boolText(earlyBearThresholdValid) + "/" + f_boolText(bearProtectsPivot), text_color = bearEarly ? bearColor : color.white, text_size = size.small)
    table.cell(earlyDebugTable, 0, 3, "Close", text_color = color.white, text_size = size.small)
    table.cell(earlyDebugTable, 1, 3, f_formatPrice(close), text_color = color.white, text_size = size.small)
    table.cell(earlyDebugTable, 0, 4, "Floor/Cap", text_color = color.white, text_size = size.small)
    table.cell(earlyDebugTable, 1, 4, f_formatPrice(bullFloor) + " / " + f_formatPrice(bearCap), text_color = color.white, text_size = size.small)
    table.cell(earlyDebugTable, 0, 5, "RSI", text_color = color.white, text_size = size.small)
    table.cell(earlyDebugTable, 1, 5, str.tostring(earlyRsi, "#.##") + " | " + str.tostring(prevPLrsi, "#.##") + " / " + str.tostring(prevPHrsi, "#.##"), text_color = color.white, text_size = size.small)
    table.cell(earlyDebugTable, 0, 6, "Bar", text_color = color.white, text_size = size.small)
    table.cell(earlyDebugTable, 1, 6, str.tostring(bar_index) + " r" + str.tostring(earlyLookbackRight) + "/" + str.tostring(earlyRightConfirmed), text_color = color.white, text_size = size.small)

if not na(activeBullFloor) and (not showEarlyDiv or close <= activeBullFloor or bullCond)
    line.delete(earlyBullLine)
    label.delete(earlyBullLabel)
    earlyBullLine := na
    earlyBullLabel := na
    activeBullFloor := na
    activeBullBar := na

if not na(activeBearCap) and (not showEarlyDiv or close >= activeBearCap or bearCond)
    line.delete(earlyBearLine)
    label.delete(earlyBearLabel)
    earlyBearLine := na
    earlyBearLabel := na
    activeBearCap := na
    activeBearBar := na

if showEarlyDiv and bullEarly and not bullCond
    earlyBullBar = bar_index - earlyLookbackRight
    if na(activeBullBar) or activeBullBar != earlyBullBar
        line.delete(earlyBullLine)
        label.delete(earlyBullLabel)
        bullLabelText = " Bull ( >" + f_formatPrice(bullFloor) + " ) "
        earlyBullLine := line.new(prevPLbar, prevPLrsi, earlyBullBar, earlyRsi, color = bullColor, width = 2)
        earlyBullLabel := label.new(earlyBullBar, earlyRsi, bullLabelText, style = label.style_label_up, color = bullColor, textcolor = textColor)
        activeBullFloor := bullFloor
        activeBullBar := earlyBullBar
if showEarlyDiv and bearEarly and not bearCond
    earlyBearBar = bar_index - earlyLookbackRight
    if na(activeBearBar) or activeBearBar != earlyBearBar
        line.delete(earlyBearLine)
        label.delete(earlyBearLabel)
        bearLabelText = " Bear ( <" + f_formatPrice(bearCap) + " ) "
        earlyBearLine := line.new(prevPHbar, prevPHrsi, earlyBearBar, earlyRsi, color = bearColor, width = 2)
        earlyBearLabel := label.new(earlyBearBar, earlyRsi, bearLabelText, style = label.style_label_down, color = bearColor, textcolor = textColor)
        activeBearCap := bearCap
        activeBearBar := earlyBearBar
alertcondition(bullEarly, title="提前看漲背離", message="提前看漲背離：收盤價高於守住價（bullFloor），且低於前一個樞紐低點價格。")
alertcondition(bearEarly, title="提前看跌背離", message="提前看跌背離：收盤價低於壓制價（bearCap），且高於前一個樞紐高點價格。")
