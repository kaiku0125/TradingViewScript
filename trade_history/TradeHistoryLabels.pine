//@version=6
indicator("Trade History Labels", overlay = true, max_labels_count = 500)

type Trade
    string symbol
    string market
    string side
    int year
    int month
    int day
    float qty
    float amount
    string price

var string TZ = "Asia/Taipei"
var array<Trade> trades = array.new<Trade>()
var color BUY_LABEL_COLOR = color.rgb(0, 102, 51)
var color SELL_LABEL_COLOR = color.rgb(153, 0, 0)

add_trade(string symbol, string market, string side, int year, int month, int day, float qty, float amount, string price) =>
    array.push(trades, Trade.new(symbol, market, side, year, month, day, qty, amount, price))

format_number(float value) =>
    str.tostring(value)

current_symbol() =>
    str.upper(syminfo.ticker)

contains_all(string source, string keyword1, string keyword2) =>
    str.contains(source, keyword1) and str.contains(source, keyword2)

symbol_matches_chart(Trade trade) =>
    chart_symbol = current_symbol()
    trade_symbol = str.upper(trade.symbol)
    if trade.market == "TW"
        trade_symbol == chart_symbol
    else if trade_symbol == "BTC"
        contains_all(chart_symbol, "BTC", "USD")
    else if trade_symbol == "ETH"
        contains_all(chart_symbol, "ETH", "USD")
    else if trade_symbol == "ADA"
        contains_all(chart_symbol, "ADA", "USD")
    else if trade_symbol == "BNB"
        contains_all(chart_symbol, "BNB", "USD")
    else if trade_symbol == "CRO"
        contains_all(chart_symbol, "CRO", "USD")
    else
        trade_symbol == chart_symbol

has_trade_date(Trade trade) =>
    trade.year > 0 and trade.month > 0 and trade.day > 0

date_key(int year_value, int month_value, int day_value) =>
    year_value * 10000 + month_value * 100 + day_value

trade_date_key(Trade trade) =>
    date_key(trade.year, trade.month, trade.day)

bar_start_date_key() =>
    date_key(year(time, TZ), month(time, TZ), dayofmonth(time, TZ))

bar_end_date_key() =>
    date_key(year(time_close - 1, TZ), month(time_close - 1, TZ), dayofmonth(time_close - 1, TZ))

is_trade_in_bar(Trade trade) =>
    has_trade_date(trade) and
     trade_date_key(trade) >= bar_start_date_key() and
     trade_date_key(trade) <= bar_end_date_key()

trade_text(Trade trade) =>
    trade.side +
     "\ndate: " + str.format("{0}-{1}-{2}", trade.year, trade.month, trade.day) +
     "\nqty: " + format_number(trade.qty) +
     "\namount: " + format_number(trade.amount) +
     "\nprice: " + trade.price

trade_marker_text(Trade trade) =>
    trade.side == "BUY" ? "B" : "S"

