// 計算資產價值和損益（根據當前價格、倉位、成本和總資產）
// currentPrice : 當前價格
// position : 持有倉位（股數或顆數）
// cost : 總成本
// totalAssets : 總資產
// exchangeRate : 匯率轉換係數
calculateAssetValue(float currentPrice, float position, float cost, float totalAssets, float exchangeRate) =>
    float adjustedPrice = currentPrice * exchangeRate
    float adjustedCost = cost * exchangeRate
    [remain, pnl, pnlPercent, nowRatio] = lib.calDefault(adjustedPrice, position, adjustedCost, totalAssets)
    [remain, pnl, pnlPercent, nowRatio]

// 計算資產再平衡資訊（目標配比與當前配比的差異）
// nowRatio : 當前配比（小數，如 0.15 表示 15%）
// targetRatio : 目標配比（百分比，如 15 表示 15%）
// remain : 當前資產價值
// totalAssets : 總資產
calculateRebalanceInfo(float nowRatio, float targetRatio, float remain, float totalAssets) =>
    float diffRatio = lib.getRatioDiff(nowRatio, targetRatio / 100)
    float rebalanceValue = totalAssets * targetRatio / 100 - remain
    string rebalanceText = fm.fString(rebalanceValue, 0) + "\t【" + fm.ratioString(diffRatio) + "】"
    [diffRatio, rebalanceValue, rebalanceText]

// 依幣價的整數部分位數決定數量顯示格式
formatRebalanceQty(float qty, float price) =>
    float absQty = math.abs(qty)
    float absPrice = math.abs(price)
    string output = if absPrice >= 10000
        fm.fString(absQty, 3)
    else if absPrice >= 1000
        fm.fString(absQty, 2)
    else if absPrice >= 100
        fm.fString(absQty, 1)
    else
        fm.fString(math.round(absQty), 0)
    output

// 將再平衡金額轉成資產買賣數量文字
appendRebalanceQtyText(string rebalanceText, float rebalanceValue, float price, bool needsUsdConversion, string unitLabel) =>
    float convertedValue = needsUsdConversion ? math.abs(rebalanceValue) / pUsd_Twd : math.abs(rebalanceValue)
    float qty = price > 0 ? convertedValue / price : na
    string output = rebalanceText
    if rebalanceValue != 0 and not na(qty)
        string action = rebalanceValue > 0 ? "買進 " : "賣出 "
        output += "\t" + action + formatRebalanceQty(qty, price) + " " + unitLabel
    output

