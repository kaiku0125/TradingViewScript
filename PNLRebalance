    int nextRow = rowID
    if asset.displayType == "withIncome"
        nextRow := displayCryptoAssetWithIncome(rowID, asset.assetName, asset.titleRatio, asset.nowRatio, asset.rebalanceText, asset.diffRatio, asset.judgeRatio, asset.remain, asset.pnl, asset.pnlPercent, asset.income, asset.cost, asset.inputCost, usdEx)
    else if asset.displayType == "withoutIncome"
        nextRow := displayCryptoAssetWithoutIncome(rowID, asset.assetName, asset.titleRatio, asset.nowRatio, asset.rebalanceText, asset.diffRatio, asset.judgeRatio, asset.remain, asset.pnl, asset.pnlPercent)
    else if asset.displayType == "blank"
        nextRow := displayCryptoAssetBlank(rowID, asset.assetName, asset.nowRatio, asset.remain, asset.pnl, asset.pnlPercent)
    else if asset.displayType == "blankWithIncome"
        nextRow := displayCryptoAssetBlankWithIncome(rowID, asset.assetName, asset.nowRatio, asset.remain, asset.pnl, asset.pnlPercent, asset.income, asset.cost, asset.inputCost, usdEx)
    nextRow

