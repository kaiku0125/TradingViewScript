// 根據 remain 值對資產數組進行降序排序（冒泡排序）
// assets : 要排序的資產數組
sortAssetsByRemain(array<CryptoAssetData> assets) =>
    int size = array.size(assets)
    if size > 1
        for i = 0 to size - 2
            for j = 0 to size - 2 - i
                asset1 = array.get(assets, j)
                asset2 = array.get(assets, j + 1)
                if asset1.remain < asset2.remain
                    array.set(assets, j, asset2)
                    array.set(assets, j + 1, asset1)
    assets

