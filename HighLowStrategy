//@version=5

import kaiku0125/Colour/8 as colour


strategy("TD高低點", overlay=true, dynamic_requests = true, max_labels_count = 500)

// 输入参数
lookbackPeriod = input.int(5, "回看周期", minval=1, tooltip="用于识别高低点的周期数，加密货币建议3-7天")
minDistance = input.int(5, "最小距离", minval=1, tooltip="两个高低点之间的最小距离，加密货币建议3-7天")
showLabels = input.bool(true, "显示标签")
showAllHL = input.bool(false, "显示历史高低点", tooltip="开启后将显示所有历史高低点标签，关闭则只显示最新一组高低点")
showTD = input.bool(true, "TD序列", tooltip="顯示所有TD序列")
tdLength = input.int(9, "TD序列长度", minval=1, tooltip="TD序列的计数长度，默认为9")
showFib = input.bool(true, "显示斐波那契", tooltip="显示斐波那契回调和延伸线")

// 计算高低点
highPoint = ta.pivothigh(high, lookbackPeriod, lookbackPeriod)
lowPoint = ta.pivotlow(low, lookbackPeriod, lookbackPeriod)

// 存储最后一个高低点
var float lastHigh = na
var float lastLow = na
var int lastHighBar = na
var int lastLowBar = na

// 存储所有高低点
var array<float> allHighs = array.new_float()
var array<float> allLows = array.new_float()
var array<int> allHighBars = array.new_int()
var array<int> allLowBars = array.new_int()

// 存储所有label的数组
var array<label> highLabels = array.new_label()
var array<label> lowLabels = array.new_label()

// 删除最旧的label
deleteOldLabels(array<label> labels) =>
    if array.size(labels) > 10
        label.delete(array.get(labels, 0))
        array.shift(labels)

// 添加新label并管理数量
addLabel(array<label> labels, x, y, labelText, color, style, textcolor, size) =>
    label newLabel = label.new(x, y, labelText, color=color, style=style, textcolor=textcolor, size=size)
    array.push(labels, newLabel)
    deleteOldLabels(labels)

// 更新高低点存储
if highPoint and barstate.isconfirmed
    lastHigh := highPoint
    lastHighBar := bar_index - lookbackPeriod
    array.push(allHighs, highPoint)
    array.push(allHighBars, bar_index - lookbackPeriod)
    // 限制数组大小为100
    if array.size(allHighs) > 20
        array.shift(allHighs)
        array.shift(allHighBars)

if lowPoint and barstate.isconfirmed
    lastLow := lowPoint
    lastLowBar := bar_index - lookbackPeriod
    array.push(allLows, lowPoint)
    array.push(allLowBars, bar_index - lookbackPeriod)
    // 限制数组大小为100
    if array.size(allLows) > 20
        array.shift(allLows)
        array.shift(allLowBars)

// TD序列计算
var int tdBuyCount = 0
var int tdSellCount = 0
var int tdSetup = 0
var bool isTDBuy = false
var bool isTDSell = false
var array<int> tdBuyBars = array.new_int()
var array<int> tdSellBars = array.new_int()
var array<bool> tdBuyDrawn = array.new_bool()
var array<bool> tdSellDrawn = array.new_bool()

// 计算斐波那契水平
var line fib618Line = na
var line fibExtLine = na
var line fib66Line = na
var line fib382Line = na
var label fib618Label = na
var label fibExtLabel = na
var label fib66Label = na
var label fib382Label = na

// 更新斐波那契线
if showFib and barstate.isconfirmed and not na(lastHigh) and not na(lastLow)
    // 删除旧的线和标签
    if not na(fib618Line)
        line.delete(fib618Line)
    if not na(fibExtLine)
        line.delete(fibExtLine)
    if not na(fib66Line)
        line.delete(fib66Line)
    if not na(fib382Line)
        line.delete(fib382Line)
    if not na(fib618Label)
        label.delete(fib618Label)
    if not na(fibExtLabel)
        label.delete(fibExtLabel)
    if not na(fib66Label)
        label.delete(fib66Label)
    if not na(fib382Label)
        label.delete(fib382Label)
    
    // 计算对数坐标下的斐波那契水平
    float logHigh = math.log(lastHigh)
    float logLow = math.log(lastLow)
    float logRange = math.abs(logHigh - logLow)
    
    // 根据最后高低点的顺序调整计算
    float logFib618 = na
    float logFibExt = na
    float logFib66 = na
    float logFib382 = na
    if lastHighBar > lastLowBar
        // 如果最后一个是高点，从高点向下计算
        logFib618 := logHigh - logRange * 0.618
        logFibExt := logHigh + logRange * 0.618
        logFib66 := logHigh - logRange * 0.66
        logFib382 := logHigh + logRange * 0.382
    else
        // 如果最后一个是低点，从低点向上计算
        logFib618 := logLow + logRange * 0.618
        logFibExt := logLow - logRange * 0.618
        logFib66 := logLow + logRange * 0.66
        logFib382 := logLow - logRange * 0.382
    
    // 转换回普通坐标
    float fib618 = math.exp(logFib618)
    float fibExt = math.exp(logFibExt)
    float fib66 = math.exp(logFib66)
    float fib382 = math.exp(logFib382)
    
    // 绘制斐波那契回调和延伸线
    fib618Line := line.new(bar_index - 1, fib618, bar_index + 100, fib618, color=color.new(color.blue, 0), style=line.style_dashed, extend=extend.right)
    fibExtLine := line.new(bar_index - 1, fibExt, bar_index + 100, fibExt, color=color.new(color.blue, 0), style=line.style_dashed, extend=extend.right)
    fib66Line := line.new(bar_index - 1, fib66, bar_index + 100, fib66, color=color.new(color.blue, 0), style=line.style_dashed, extend=extend.right)
    fib382Line := line.new(bar_index - 1, fib382, bar_index + 100, fib382, color=color.new(color.blue, 0), style=line.style_dashed, extend=extend.right)
    
    // 添加标签
    fib618Label := label.new(bar_index, fib618, "0.618", color=color.new(color.blue, 70), style=label.style_label_left, textcolor=color.white, size=size.small)
    fibExtLabel := label.new(bar_index, fibExt, "1.618", color=color.new(color.blue, 70), style=label.style_label_left, textcolor=color.white, size=size.small)
    fib66Label := label.new(bar_index, fib66, "0.66", color=color.new(color.blue, 70), style=label.style_label_left, textcolor=color.white, size=size.small)
    fib382Label := label.new(bar_index, fib382, "1.382", color=color.new(color.blue, 70), style=label.style_label_left, textcolor=color.white, size=size.small)

// 计算TD序列
if barstate.isconfirmed
    if close > close[4]
        tdBuyCount := tdBuyCount + 1
        array.push(tdBuyBars, bar_index)
        array.push(tdBuyDrawn, false)
        if tdBuyCount >= tdLength
            isTDBuy := true
            tdSetup := tdBuyCount
    else
        tdBuyCount := 0
        isTDBuy := false
        array.clear(tdBuyBars)
        array.clear(tdBuyDrawn)

    if close < close[4]
        tdSellCount := tdSellCount + 1
        array.push(tdSellBars, bar_index)
        array.push(tdSellDrawn, false)
        if tdSellCount >= tdLength
            isTDSell := true
            tdSetup := tdSellCount
    else
        tdSellCount := 0
        isTDSell := false
        array.clear(tdSellBars)
        array.clear(tdSellDrawn)

// 绘制高低点
if showLabels and barstate.isconfirmed
    // 如果不是显示所有历史高低点，则清空标签数组
    if not showAllHL
        // 清空所有标签
        if array.size(highLabels) > 0
            for i = 0 to array.size(highLabels) - 1
                label.delete(array.get(highLabels, i))
            array.clear(highLabels)
        if array.size(lowLabels) > 0
            for i = 0 to array.size(lowLabels) - 1
                label.delete(array.get(lowLabels, i))
            array.clear(lowLabels)
    
    // 绘制所有高低点
    if array.size(allHighs) > 0
        for i = 0 to array.size(allHighs) - 1
            float highPrice = array.get(allHighs, i)
            int highBar = array.get(allHighBars, i)
            if showAllHL or i == array.size(allHighs) - 1
                addLabel(highLabels, highBar, highPrice*1.02, "H", color.red, label.style_label_down, color.white, size.tiny)
    
    if array.size(allLows) > 0
        for i = 0 to array.size(allLows) - 1
            float lowPrice = array.get(allLows, i)
            int lowBar = array.get(allLowBars, i)
            if showAllHL or i == array.size(allLows) - 1
                addLabel(lowLabels, lowBar, lowPrice*0.98, "L", color.green, label.style_label_up, color.white, size.tiny)

// 绘制高低点连线
var line highLine = na
var line lowLine = na

if highPoint and barstate.isconfirmed
    if not na(highLine)
        line.delete(highLine)
    highLine := line.new(bar_index - lookbackPeriod, highPoint, bar_index - lookbackPeriod, highPoint, color=color.red, style=line.style_dashed)

if lowPoint and barstate.isconfirmed
    if not na(lowLine)
        line.delete(lowLine)
    lowLine := line.new(bar_index - lookbackPeriod, lowPoint, bar_index - lookbackPeriod, lowPoint, color=color.green, style=line.style_dashed)

// 绘制TD买入序列标签
if showTD and array.size(tdBuyBars) > 0 and barstate.isconfirmed
    for i = 0 to array.size(tdBuyBars) - 1
        int bar = array.get(tdBuyBars, i)
        int count = i + 1
        bool drawn = array.get(tdBuyDrawn, i)
        
        // 标记7、8、9和11、12、13的K线，且只绘制未绘制过的
        if (count >= 7 and count <= 9 or count >= 11 and count <= 13) and not drawn
            string labelText = str.tostring(count)
            color labelColor = color.new(color.red, 0)
            float labelY = high[bar_index - bar] * 1.01
            label.new(bar, labelY, labelText, color=labelColor, style=label.style_text_outline, textcolor=color.white, size=size.tiny)
            array.set(tdBuyDrawn, i, true)

// 绘制TD卖出序列标签
if showTD and array.size(tdSellBars) > 0 and barstate.isconfirmed
    for i = 0 to array.size(tdSellBars) - 1
        int bar = array.get(tdSellBars, i)
        int count = i + 1
        bool drawn = array.get(tdSellDrawn, i)
        
        // 标记7、8、9和11、12、13的K线，且只绘制未绘制过的
        if (count >= 7 and count <= 9 or count >= 11 and count <= 13) and not drawn
            string labelText = str.tostring(count)
            color labelColor = color.new(color.green, 0)
            float labelY = low[bar_index - bar] * 0.99
            label.new(bar, labelY, labelText, color=labelColor, style=label.style_text_outline, textcolor=color.white, size=size.tiny)
            array.set(tdSellDrawn, i, true)

// 计算当前价格与最近高低点的距离
float distanceToHigh = na
float distanceToLow = na

if not na(lastHigh) and not na(lastHighBar)
    distanceToHigh := (lastHigh - close) / close * 100

if not na(lastLow) and not na(lastLowBar)
    distanceToLow := (close - lastLow) / close * 100

